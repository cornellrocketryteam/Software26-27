        "kind": "pwm",
        "direction": "output",
        "bias": "none"
      }
    },
    "settings": {}
  },
  "ball_valve": {
    "label": "Ball valve",
    "ports": {
      "on_off": {
        "kind": "gpio",
        "direction": "output",
        "bias": "pull-down"
      },
      "signal": {
        "kind": "gpio",
        "direction": "output",
        "bias": "pull-down"
      }
    },
    "settings": {}
  },
  "qd_stepper": {
    "label": "QD stepper",
