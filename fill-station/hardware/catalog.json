{
  "igniter": {
    "label": "Igniter",
    "ports": {
      "continuity": {
        "kind": "gpio",
        "direction": "input",
        "bias": "pull-down"
      },
      "signal": {
        "kind": "gpio",
        "direction": "output",
        "bias": "pull-down"
      }
    },
    "settings": {}
  },
  "solenoid_valve": {
    "label": "Solenoid valve",
    "ports": {
      "control": {
        "kind": "gpio",
        "direction": "output",
        "bias": "pull-down"
      },
      "sense": {
        "kind": "gpio",
        "direction": "input",
        "bias": "none"
      }
    },
    "settings": {
      "valve_type": {
        "label": "Valve behavior",
        "type": "enum",
        "choices": [
          "normally_closed",
          "normally_open"
        ],
        "default": "normally_closed"
      }
    }
  },
  "ads1015": {
    "label": "ADS1015 ADC",
