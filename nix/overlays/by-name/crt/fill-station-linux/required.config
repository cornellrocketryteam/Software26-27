# Options the fill-station image cannot run without. The kernel build fails if
# any of these is not =y in the resolved config. Keep in sync with the
# peripheral checklist in the Stage 2 plan; never drop the umbilical block.

# Boot / SoC
CONFIG_ARCH_K3=y
CONFIG_TI_SCI_PROTOCOL=y
CONFIG_TI_SCI_INTA_IRQCHIP=y
CONFIG_TI_SCI_INTR_IRQCHIP=y
CONFIG_TI_MESSAGE_MANAGER=y
CONFIG_TI_SCI_CLK=y
CONFIG_TI_SCI_PM_DOMAINS=y
CONFIG_RESET_TI_SCI=y
CONFIG_TI_K3_RINGACC=y
CONFIG_TI_K3_UDMA=y
CONFIG_K3_DMA=y
CONFIG_TI_K3_SOCINFO=y
CONFIG_PINCTRL_SINGLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_OMAP=y
CONFIG_SERIAL_8250_CONSOLE=y

# Storage: SD card (boot + DATA partition, vfat)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI_AM654=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# MixOS (boot.requiredKernelConfig) and init
CONFIG_BLK_DEV_LOOP=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_FUTEX=y
CONFIG_OVERLAY_FS=y
CONFIG_RD_XZ=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_BINFMT_ELF=y

# Fill-station app I/O: GPIO, ADC over I2C, MAV PWM (/sys/class/pwm)
CONFIG_GPIO_DAVINCI=y
CONFIG_GPIO_CDEV=y
CONFIG_I2C_OMAP=y
CONFIG_I2C_CHARDEV=y
CONFIG_PWM=y
CONFIG_PWM_TIEHRPWM=y

# Umbilical: FSW over USB CDC-ACM (/dev/ttyACM0), cdns3 in host mode + xHCI
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_CDNS_SUPPORT=y
CONFIG_USB_CDNS3=y
CONFIG_USB_CDNS3_HOST=y
CONFIG_USB_CDNS3_TI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CP210X=y

# Network
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PACKET=y
# Wi-Fi (to be removed once Ethernet works)
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLCORE_SDIO=y
CONFIG_WL18XX=y
CONFIG_FW_LOADER=y
# Ethernet
CONFIG_TI_K3_AM65_CPSW_NUSS=y
CONFIG_DP83867_PHY=y

# Platform: watchdog driver (service stays disabled), OSPI flash for Stage 3
CONFIG_K3_RTI_WATCHDOG=y
CONFIG_MTD=y
CONFIG_SPI=y
CONFIG_MTD_SPI_NOR=y
CONFIG_SPI_CADENCE_QUADSPI=y
