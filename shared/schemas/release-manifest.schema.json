{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cornellrocketry.org/schemas/release-manifest.schema.json",
  "title": "Ground platform build manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "createdAt", "host", "vehicle", "source", "profileSha256", "classification", "build", "artifacts", "bootloaderVersion", "tests", "publication", "deployment", "preparedInputsRetained"],
  "properties": {
    "schemaVersion": {"const": 1},
    "releaseId": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{32}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "host": {"enum": ["fill-station", "ground-station"]},
    "vehicle": {"enum": ["liquid", "hybrid", null]},
    "classification": {"enum": ["development", "candidate"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "dirty", "snapshot", "snapshotSha256", "lockSha256", "excludedUntracked", "snapshotPolicy"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "dirty": {"type": "boolean"},
        "snapshot": {"$ref": "#/$defs/absolutePath"},
        "snapshotSha256": {"$ref": "#/$defs/sha256"},
        "lockSha256": {"$ref": "#/$defs/sha256"},
        "excludedUntracked": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "snapshotPolicy": {"const": "tracked-working-files-v1"}
      }
    },
    "profileSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "worker", "selectionReason", "offline", "logDirectory"],
      "properties": {
        "platform": {"enum": ["aarch64-linux", "x86_64-linux"]},
        "worker": {"enum": ["local", "station"]},
        "selectionReason": {"type": "string", "minLength": 1},
        "offline": {"type": "boolean"},
        "logDirectory": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "artifacts": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "sd": {"$ref": "#/$defs/artifact"},
        "fit": {"$ref": "#/$defs/artifact"},
        "ospi": {"$ref": "#/$defs/artifact"},
        "data": {"$ref": "#/$defs/artifact"},
        "system": {"$ref": "#/$defs/artifact"}
      }
    },
    "bootloaderVersion": {"type": ["string", "null"], "description": "Null until measured/queried; never infer hardware version."},
    "tests": {"type": "array", "items": {"type": "string"}, "description": "Only tests actually run for this build; empty does not mean tested."},
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "statusSource"],
      "properties": {"state": {"const": "pending"}, "statusSource": {"$ref": "#/$defs/absolutePath"}}
    },
    "deployment": {
      "type": "object", "additionalProperties": false,
      "required": ["state"], "properties": {"state": {"const": "not-deployed"}}
    },
    "preparedInputsRetained": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"host": {"const": "fill-station"}}},
     "then": {"properties": {"vehicle": {"enum": ["liquid", "hybrid"]}, "profileSha256": {"$ref": "#/$defs/sha256"}, "artifacts": {"not": {"required": ["system"]}}}},
     "else": {"properties": {"vehicle": {"type": "null"}, "profileSha256": {"type": "null"}, "build": {"properties": {"platform": {"const": "x86_64-linux"}}}, "artifacts": {"required": ["system"], "maxProperties": 1}}}},
    {"if": {"properties": {"source": {"properties": {"dirty": {"const": true}}}}}, "then": {"properties": {"classification": {"const": "development"}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "relativePath", "kind", "sizeBytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "relativePath": {"type": "string", "minLength": 1},
        "kind": {"enum": ["file", "symlink"]},
        "sizeBytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["attribute", "drvPath", "storePath", "outputPath", "gcRoot", "files", "sizeBytes"],
      "properties": {
        "attribute": {"type": "string", "minLength": 1},
        "drvPath": {"$ref": "#/$defs/absolutePath"},
        "storePath": {"$ref": "#/$defs/absolutePath"},
        "outputPath": {"$ref": "#/$defs/absolutePath"},
        "gcRoot": {"$ref": "#/$defs/absolutePath"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
        "sizeBytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
